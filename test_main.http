@RAG_API_KEY=test

### Ингест локальных PDF/DOCX/TXT/CSV/MD/HTML файлов
# curl -X POST "http://127.0.0.1:8000/ingest/files" \
#   -H "X-API-Key: <RAG_API_KEY>" \
#   -H "Content-Type: application/json" \
#   -d '{"folder":"./rag_docs","replace_existing":true}'
# @timeout 60000
POST http://127.0.0.1:8000/ingest/files
X-API-Key: {{RAG_API_KEY}}
Content-Type: application/json

{
  "folder": "./data/rag_docs",
  "replace_existing": true
}


### Ингест сайта example.com с обходом до 100 страниц в пределах одного домена
# curl -X POST "http://127.0.0.1:8000/ingest/site" \
#   -H "X-API-Key: <RAG_API_KEY>" \
#   -H "Content-Type: application/json" \
#   -d '{"base_url":"https://example.com","max_pages":100}'
# @timeout 60000
POST http://127.0.0.1:8000/ingest/site
X-API-Key: {{RAG_API_KEY}}
Content-Type: application/json

{
  "base_url": "https://example.com",
  "max_pages": 100
}


### RAG вопрос
# curl -N -X POST "http://127.0.0.1:8000/ask" -H "X-API-Key: <RAG_API_KEY>" -H "Content-Type: application/json" -d '{"messages":[{"role":"user","content":"What the kolobok said to wolf?"}],"sources":["rag_docs"],"top_k":6,"temperature":0.4,"stream":true}'
# @timeout 60000
POST http://127.0.0.1:8000/ask
X-API-Key: {{RAG_API_KEY}}
Content-Type: application/json

{
  "messages": [
    {
      "role": "user",
      "content": "What the Kolobok said to wolf?"
    }
  ],
  "sources": [
    "docs"
  ],
  "top_k": 6,
  "temperature": 0.4,
  "stream": true
}


### RAG вопрос по локальным документам и сайту с site_domain
# curl -X POST "http://127.0.0.1:8000/ask" -H "X-API-Key: <RAG_API_KEY>" -H "Content-Type: application/json" -d '{"messages":[{"role":"user","content":"О чем твоя база данных"}],"sources":["rag_docs","site"],"site_domain":"example.com","top_k":6,"temperature":0.4,"stream":false}'
# @timeout 600
POST http://127.0.0.1:8000/ask
X-API-Key: {{RAG_API_KEY}}
Content-Type: application/json

{
  "messages": [
    {
      "role": "user",
      "content": "О чем твоя база данных"
    }
  ],
  "sources": [
    "docs",
    "site"
  ],
  "site_domain": "example.com",
  "top_k": 6,
  "temperature": 0.4,
  "stream": false
}

### Прямой запрос к BitNet completion без RAG
# curl -N -X POST "http://127.0.0.1:8080/completion" \
#   -H "Content-Type: application/json" \
#   -d '{"prompt":"<|begin_of_text|><|start_header_id|>system<|end_header_id|>You are an assistant. Respond ONLY based on the provided Context. Do not use external knowledge. Always at the end, add the line '\''Sources: '\'' followed by the [id] of the chunks.<|eot_id|><|start_header_id|>user<|end_header_id|>Question: '\''2+2='\''\nContext:\n'\''[doc:file.txt:0]\n2+2=4'\''<|eot_id|><|start_header_id|>assistant<|end_header_id|>","temperature":0.2,"n_predict":128,"stream":true}'
# @timeout 600
POST http://127.0.0.1:8080/completion
Content-Type: application/json

{
  "prompt": "<|begin_of_text|><|start_header_id|>system<|end_header_id|>You are an assistant. Respond ONLY based on the provided Context. Do not use external knowledge. Always at the end, add the line 'Sources: ' followed by the [id] of the chunks.<|eot_id|><|start_header_id|>user<|end_header_id|>Question: '2+2='\nContext:\n'[doc:file.txt:0]\n2+2=4'<|eot_id|><|start_header_id|>assistant<|end_header_id|>",
  "temperature": 0.2,
  "n_predict": 128,
  "stream": true
}


### Прямой запрос к BitNet chat без RAG
# curl -N -X POST "http://127.0.0.1:8080/v1/chat/completions" \
#   -H "Content-Type: application/json" \
#   -d '{"messages":[{"role":"system","content":"You are an assistant. Respond ONLY based on the provided Context. Do not use external knowledge. Always at the end, add the line '\''Sources: '\'' followed by the [id] of the chunks."},{"role":"user","content":"Question: '\''2+2='\''\nContext:\n'\''[doc:file.txt:0]\n2+2=4'\''"}],"temperature":0.2,"n_predict":128,"stream":true}'
# @timeout 600
POST http://127.0.0.1:8080/v1/chat/completions
Content-Type: application/json

{
  "messages": [
    {
      "role": "system",
      "content": "You are an assistant. Respond ONLY based on the provided Context. Do not use external knowledge. Always at the end, add the line 'Sources: ' followed by the [id] of the chunks."
    },
    {
      "role": "user",
      "content": "Question: '2+2='\nContext:\n'[doc:file.txt:0]\n2+2=4'"
    }
  ],
  "temperature": 0.2,
  "n_predict": 128
}
