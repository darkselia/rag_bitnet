### Ингест локальных TXT/MD файлов из папки docs с заменой уже проиндексированных чанков этих файлов
# curl -X POST "http://127.0.0.1:8000/ingest/files" \
#   -H "Content-Type: application/json" \
#   -d '{"folder":"./rag_docs","replace_existing":true}'
# @timeout 600
POST http://127.0.0.1:8000/ingest/files
Content-Type: application/json

{
  "folder": "./data/rag_docs",
  "replace_existing": true
}


### Ингест сайта example.com с обходом до 100 страниц в пределах одного домена
# curl -X POST "http://127.0.0.1:8000/ingest/site" \
#   -H "Content-Type: application/json" \
#   -d '{"base_url":"https://example.com","max_pages":100}'
# @timeout 600
POST http://127.0.0.1:8000/ingest/site
Content-Type: application/json

{
  "base_url": "https://example.com",
  "max_pages": 100
}


### RAG вопрос только по локальным документам (JSON)
# curl -X POST "http://127.0.0.1:8000/ask" -H "Content-Type: application/json" -d '{"messages":[{"role":"user","content":"In what order did the bun visit the animals?"}],"sources":["rag_docs"],"top_k":6,"temperature":0.5,"stream":false}'
# @timeout 600
POST http://127.0.0.1:8000/ask
Content-Type: application/json

{
  "messages": [
    {
      "role": "user",
      "content": "In what order did the kolobok visit the animals?"
    }
  ],
  "sources": [
    "docs"
  ],
  "top_k": 6,
  "temperature": 0.5,
  "stream": true
}


### RAG вопрос — стриминг
# curl -N -X POST "http://127.0.0.1:8000/ask" -H "Content-Type: application/json" -d '{"messages":[{"role":"user","content":"What bun said to wolf?"}],"sources":["rag_docs"],"top_k":6,"temperature":0.4,"stream":true}'
# @timeout 600
POST http://127.0.0.1:8000/ask
Content-Type: application/json

{
  "messages": [
    {
      "role": "user",
      "content": "What bun said to wolf?"
    }
  ],
  "sources": [
    "docs"
  ],
  "top_k": 6,
  "temperature": 0.4,
  "stream": true
}


### RAG вопрос по локальным документам и сайту с site_domain
# curl -X POST "http://127.0.0.1:8000/ask" -H "Content-Type: application/json" -d '{"messages":[{"role":"user","content":"О чем твоя база данных"}],"sources":["rag_docs","site"],"site_domain":"example.com","top_k":6,"temperature":0.4,"stream":false}'
# @timeout 600
POST http://127.0.0.1:8000/ask
Content-Type: application/json

{
  "messages": [
    {
      "role": "user",
      "content": "О чем твоя база данных"
    }
  ],
  "sources": [
    "docs",
    "site"
  ],
  "site_domain": "example.com",
  "top_k": 6,
  "temperature": 0.4,
  "stream": false
}


### RAG вопрос с кастомным system prompt в начале messages
# curl -X POST "http://127.0.0.1:8000/ask" -H "Content-Type: application/json" -d '{"messages":[{"role":"system","content":"Отвечай кратко, максимум 2 предложения."},{"role":"user","content":"What is RAG?"}],"top_k":6,"max_tokens":200,"stream":false}'
# @timeout 600
POST http://127.0.0.1:8000/ask
Content-Type: application/json

{
  "messages": [
    {
      "role": "system",
      "content": "Отвечай кратко, максимум 2 предложения."
    },
    {
      "role": "user",
      "content": "What is RAG?"
    }
  ],
  "top_k": 6,
  "max_tokens": 200,
  "stream": false
}


### Прямой запрос к BitNet completion без retrieval и без локального RAG контекста сервера
# curl -N -X POST "http://127.0.0.1:8080/completion" \
#   -H "Content-Type: application/json" \
#   -d '{"prompt":"<|begin_of_text|><|start_header_id|>system<|end_header_id|>You are an assistant. Respond ONLY based on the provided Context. Do not use external knowledge. Always at the end, add the line '\''Sources: '\'' followed by the [id] of the chunks.<|eot_id|><|start_header_id|>user<|end_header_id|>Question: '\''2+2='\''\nContext:\n'\''[doc:file.txt:0]\n2+2=4'\''<|eot_id|><|start_header_id|>assistant<|end_header_id|>","temperature":0.2,"n_predict":128,"stream":true}'
# @timeout 600
POST http://127.0.0.1:8080/completion
Content-Type: application/json

{
  "prompt": "<|begin_of_text|><|start_header_id|>system<|end_header_id|>You are an assistant. Respond ONLY based on the provided Context. Do not use external knowledge. Always at the end, add the line 'Sources: ' followed by the [id] of the chunks.<|eot_id|><|start_header_id|>user<|end_header_id|>Question: '2+2='\nContext:\n'[doc:file.txt:0]\n2+2=4'<|eot_id|><|start_header_id|>assistant<|end_header_id|>",
  "temperature": 0.2,
  "n_predict": 128,
  "stream": true
}
