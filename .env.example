# API
API_HOST=0.0.0.0
API_PORT=8000

# Storage
DATA_DIR=./data

# Retrieval / models
EMBED_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
USE_CROSS_RERANKER=true
CROSS_RERANKER_TOPK=12
EMBED_BATCH=64
RERANKER_BATCH=16

# LLM
LLM_PROVIDER=bitnet
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.6
SYSTEM_PROMPT="You answer questions using only the provided context.\n Return only the final answer, without repeating the question or context.\n If the answer is present, give a complete answer using all relevant details from the context.\n    When the question asks what someone said, include the full relevant utterance.\n If the context does not contain the answer, reply exactly: Couldn't find the answer in the database.\n"

# BitNet client
BITNET_HOST=127.0.0.1
BITNET_PORT=8080
BITNET_TIMEOUT=60000
BITNET_MODE=chat
